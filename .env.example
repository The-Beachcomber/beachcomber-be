# Set to true to return fixed fake data without touching the network.
USE_MOCK_HERMES=false

HERMES_BASE_URL=https://hackathon-hermes-heh26wyhpq-de.a.run.app
HERMES_ENDPOINT_PATH=/v1/responses
HERMES_API_KEY=
HERMES_MODEL=hackathon-hermes
HERMES_TIMEOUT_SECONDS=120
HERMES_RETRY_ATTEMPTS=6
HERMES_RETRY_DELAY_SECONDS=5

# Prototype generation has its own endpoint that uploads the HTML itself.
# Measured 21-40s, so 180 leaves room without hanging forever.
HERMES_PROTOTYPE_PATH=/v1/prototypes
PROTOTYPE_TIMEOUT_SECONDS=180
PROTOTYPE_ATTEMPTS=2
PROTOTYPE_BUCKET=research-report-transactions-prototypes-20260905

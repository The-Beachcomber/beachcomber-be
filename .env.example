# ---- LLM ----
# mock = 不呼叫 Hermes，回傳可預測的假資料（前端平行開發 / Demo 備援）
# hermes = 呼叫真實 LLM
LLM_MODE=mock
HERMES_BASE_URL=https://hackathon-hermes-heh26wyhpq-de.a.run.app
HERMES_API_KEY=
# 留空則 payload 不帶 model 欄位；若 Hermes 要求指定模型請填入
HERMES_MODEL=
HERMES_TIMEOUT_SECONDS=120
HERMES_JSON_MODE=false

# ---- 儲存 ----
# local = 落檔到 STORAGE_ROOT；gcs = 落檔到 GCS_BUCKET（Cloud Run 用這個）
STORAGE_BACKEND=local
STORAGE_ROOT=./storage
GCS_BUCKET=
GCS_PUBLIC_BASE_URL=

# ---- CORS ----
CORS_ORIGINS=*
